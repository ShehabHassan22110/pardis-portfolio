<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom IIS config merged into the published web.config (the SDK injects the
  <aspNetCore> handler on publish). Two fixes for shared IIS hosting:
   1. Remove the WebDAV module/handler — it intercepts POST/PUT on some hosts and
      returns 405 Method Not Allowed, which breaks admin image uploads.
   2. Raise the request size limit so larger images/videos can be uploaded
      (default IIS cap is ~30 MB).
-->
<configuration>
  <system.webServer>
    <modules runAllManagedModulesForAllRequests="false">
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <security>
      <requestFiltering>
        <!-- 200 MB, in bytes -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
