@page
@model LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in · BARDEES CMS</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root{--bg:#17120e;--surface:#1e1813;--surface2:#251d17;--line:rgba(240,233,220,.12);--text:#f0e9dc;--muted:#8f8474;--gold:#c98a5e;--gold2:#e0b489;--gold-deep:#a8663f;--danger:#d9705f;--serif:"Fraunces",Georgia,serif;--font:"Outfit",system-ui,sans-serif;}
        *{box-sizing:border-box;}
        body{margin:0;min-height:100vh;font-family:var(--font);font-weight:300;color:var(--text);
             background:radial-gradient(130% 100% at 15% 10%,#241b14 0%,#140f0b 60%);display:grid;place-items:center;padding:24px;position:relative;overflow:hidden;}
        body::before{content:"BARDEES";position:absolute;inset:auto -6% -18% auto;font-family:var(--serif);font-weight:600;font-size:26vw;color:rgba(224,180,137,.035);white-space:nowrap;pointer-events:none;}
        .card{position:relative;width:100%;max-width:420px;background:linear-gradient(180deg,#211a14,#1a140f);
              border:1px solid var(--line);border-radius:20px;padding:40px 36px;box-shadow:0 40px 90px -50px rgba(0,0,0,.9);}
        .brand{display:flex;align-items:center;gap:12px;margin-bottom:6px;}
        .brand__mono{width:46px;height:46px;display:grid;place-items:center;font-family:var(--serif);font-size:1.5rem;font-weight:600;color:#17120e;background:linear-gradient(135deg,var(--gold2),var(--gold-deep));border-radius:12px;}
        .brand__t{font-weight:600;font-size:1.25rem;letter-spacing:.01em;}
        .brand__t span{color:var(--gold);}
        .brand__t small{display:block;font-size:.6rem;letter-spacing:.34em;color:var(--muted);font-weight:500;}
        h1{font-family:var(--serif);font-weight:500;font-size:1.7rem;margin:26px 0 4px;}
        .sub{color:var(--muted);font-size:.9rem;margin:0 0 26px;}
        label{display:block;font-size:.76rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:7px;}
        .field{margin-bottom:18px;position:relative;}
        .field .ic{position:absolute;left:14px;top:41px;color:var(--muted);}
        input[type=email],input[type=password]{width:100%;background:var(--surface2);border:1px solid var(--line);color:var(--text);
              border-radius:11px;padding:.8rem .9rem .8rem 40px;font-family:var(--font);font-size:.95rem;transition:border-color .25s,box-shadow .25s;}
        input:focus{outline:none;border-color:var(--gold);box-shadow:0 0 0 3px rgba(201,138,94,.15);}
        .row-between{display:flex;align-items:center;justify-content:space-between;margin-bottom:22px;}
        .check{display:flex;align-items:center;gap:8px;color:var(--muted);font-size:.85rem;cursor:pointer;}
        .check input{accent-color:var(--gold);width:16px;height:16px;}
        .btn{width:100%;border:none;cursor:pointer;background:linear-gradient(135deg,var(--gold2),var(--gold-deep));color:#17120e;
              font-weight:600;font-size:.98rem;padding:.85rem;border-radius:11px;display:flex;align-items:center;justify-content:center;gap:8px;transition:filter .25s,transform .2s;}
        .btn:hover{filter:brightness(1.07);transform:translateY(-1px);}
        .alert{background:rgba(217,112,95,.12);border:1px solid rgba(217,112,95,.35);color:var(--danger);
               border-radius:11px;padding:.7rem .9rem;font-size:.86rem;margin-bottom:20px;display:flex;gap:8px;align-items:flex-start;}
        .alert ul{margin:0;padding-left:1.1rem;list-style:none;}
        .back{display:inline-flex;align-items:center;gap:6px;margin-top:24px;color:var(--muted);font-size:.85rem;text-decoration:none;transition:color .25s;}
        .back:hover{color:var(--gold2);}
        .field-hint{color:var(--danger);font-size:.78rem;margin-top:5px;display:block;}
    </style>
</head>
<body>
    <div class="card">
        <div class="brand">
            <span class="brand__mono">B</span>
            <span class="brand__t">Bardees<span>.</span><small>CMS</small></span>
        </div>
        <h1>Welcome back</h1>
        <p class="sub">Sign in to manage the BARDEES site.</p>

        <form method="post">
            <div asp-validation-summary="All" class="alert" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")">
                <i class="bi bi-exclamation-circle"></i><div></div>
            </div>

            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <i class="bi bi-envelope ic"></i>
                <input asp-for="Input.Email" autocomplete="username" autofocus placeholder="you@bardeesissa.com" />
                <span asp-validation-for="Input.Email" class="field-hint"></span>
            </div>

            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <i class="bi bi-lock ic"></i>
                <input asp-for="Input.Password" autocomplete="current-password" placeholder="••••••••" />
                <span asp-validation-for="Input.Password" class="field-hint"></span>
            </div>

            <div class="row-between">
                <label class="check"><input asp-for="Input.RememberMe" type="checkbox" /> Remember me</label>
            </div>

            <button type="submit" class="btn"><i class="bi bi-box-arrow-in-right"></i> Sign in</button>
        </form>

        <a class="back" href="/"><i class="bi bi-arrow-left"></i> Back to website</a>
    </div>
</body>
</html>
