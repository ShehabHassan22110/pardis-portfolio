@model UserCreateVm
@{
    ViewData["Title"] = "New user";
    var header = new PageHeaderModel { Title = "New user", Subtitle = "Create an admin account." };
    var roles = (string[])ViewBag.Roles;
}
<partial name="_PageHeader" model="header" />

<form asp-action="Create" method="post" class="form-cms">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="admin-alert admin-alert--danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

    <div class="editor-layout">
        <div class="card-cms"><div class="card-cms__body">
            <div class="form-row"><label asp-for="FullName"></label><input asp-for="FullName" class="form-control" /><span asp-validation-for="FullName" class="text-danger"></span></div>
            <div class="form-row"><label asp-for="Email"></label><input asp-for="Email" class="form-control" autocomplete="off" /><span asp-validation-for="Email" class="text-danger"></span></div>
            <div class="form-row"><label asp-for="Password"></label><input asp-for="Password" type="password" class="form-control" autocomplete="new-password" /><span asp-validation-for="Password" class="text-danger"></span></div>
        </div></div>

        <div class="card-cms"><div class="card-cms__body">
            <h3 class="section-title">Role</h3>
            <div class="form-row">
                <label asp-for="Role"></label>
                <select asp-for="Role" class="form-select">
                    @foreach (var r in roles)
                    {
                        <option value="@r" selected="@(Model.Role == r)">@r</option>
                    }
                </select>
                <span asp-validation-for="Role" class="text-danger"></span>
            </div>
            <div style="display:flex;gap:10px;margin-top:22px">
                <button type="submit" class="btn-gold"><i class="bi bi-check-lg"></i> Create user</button>
                <a class="btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div></div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
