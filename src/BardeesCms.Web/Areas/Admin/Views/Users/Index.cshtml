@model List<UserListItem>
@{
    ViewData["Title"] = "Users";
    var header = new PageHeaderModel { Title = "Users", Subtitle = "Admin accounts and their roles.", ActionText = "New user", ActionUrl = Url.Action("Create") };
}
@Html.AntiForgeryToken()
<partial name="_PageHeader" model="header" />

<div class="card-cms"><div class="card-cms__body" style="padding:0">
    @if (Model.Any())
    {
        <table class="table-cms">
            <thead><tr>
                <th>User</th>
                <th>Roles</th>
                <th style="width:160px" class="d-none d-md-table-cell">Last login</th>
                <th style="width:90px">Active</th>
                <th style="width:120px;text-align:right">Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var u in Model)
            {
                <tr data-id="@u.Id">
                    <td data-label="User">
                        <a class="cell-title" asp-action="Edit" asp-route-id="@u.Id">@(string.IsNullOrEmpty(u.FullName) ? u.Email : u.FullName)</a>
                        <div style="font-size:.78rem;color:var(--a-muted)">@u.Email</div>
                    </td>
                    <td data-label="Roles">
                        @if (u.Roles.Any()) { foreach (var r in u.Roles) { <span class="badge-cms">@r</span> } }
                        else { <span style="color:var(--a-muted)">—</span> }
                    </td>
                    <td data-label="Last login" class="d-none d-md-table-cell">@(u.LastLoginAt?.ToString("dd MMM yyyy, HH:mm") ?? "—")</td>
                    <td data-label="Active">
                        @if (u.IsActive) { <span class="badge-cms badge-featured">Active</span> } else { <span class="badge-cms">Disabled</span> }
                    </td>
                    <td data-label="Actions"><div class="row-actions">
                        <a class="btn-icon" asp-action="Edit" asp-route-id="@u.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = u.Id })" data-delete-name="@u.Email" title="Delete"><i class="bi bi-trash"></i></button>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="bi bi-people"></i><h3>No users</h3></div> }
</div></div>
