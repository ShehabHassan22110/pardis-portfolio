@model AbayaFormVm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New abaya" : "Edit abaya";
    var header = new PageHeaderModel { Title = (string)ViewData["Title"]!, Subtitle = isNew ? "Add a design to the abaya collection." : Model.Name };
    var preview = BardeesCms.Web.Services.ImageResolver.Src(Model.CoverImage, "portrait");
}
<partial name="_PageHeader" model="header" />

@if (!isNew)
{
    <div style="margin-bottom:14px"><a class="btn-ghost" href="/abayas/@Model.Slug" target="_blank"><i class="bi bi-box-arrow-up-right"></i> Preview</a></div>
}

<form asp-action="@(isNew ? "Create" : "Edit")" method="post" enctype="multipart/form-data" class="form-cms">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CoverImage" />
    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

    <div class="editor-layout">
        <div class="card-cms"><div class="card-cms__body">
            <div class="field-pair">
                <div class="form-row"><label asp-for="Name" class="lang-tag">EN</label><input asp-for="Name" class="form-control" data-slug-source="#Slug" /><span asp-validation-for="Name" class="text-danger"></span></div>
                <div class="form-row"><label asp-for="NameAr" class="lang-tag">AR</label><input asp-for="NameAr" class="form-control" dir="rtl" /></div>
            </div>
            <div class="form-row"><label asp-for="Slug"></label><input asp-for="Slug" id="Slug" class="form-control" placeholder="Auto-generated from name if blank" /><span class="hint">URL: /abayas/<strong>your-slug</strong></span></div>
            <div class="field-pair">
                <div class="form-row"><label asp-for="Fabric" class="lang-tag">Fabric · EN</label><input asp-for="Fabric" class="form-control" placeholder="e.g. Crêpe · Hand embroidery" /></div>
                <div class="form-row"><label asp-for="FabricAr" class="lang-tag">Fabric · AR</label><input asp-for="FabricAr" class="form-control" dir="rtl" /></div>
            </div>

            <h3 class="section-title" style="margin-top:18px">Details <span class="hint">— shown on the abaya page</span></h3>
            <div class="field-pair">
                <div class="form-row"><label asp-for="Description" class="lang-tag">About · EN</label><textarea asp-for="Description" class="form-control" data-richtext></textarea></div>
                <div class="form-row"><label asp-for="DescriptionAr" class="lang-tag">About · AR</label><textarea asp-for="DescriptionAr" class="form-control" data-richtext dir="rtl"></textarea></div>
            </div>

            <div class="form-row">
                <label asp-for="VideoUrl"></label>
                <input asp-for="VideoUrl" class="form-control" placeholder="https://youtu.be/… or a .mp4 link" />
                <span class="hint">Paste a YouTube or Vimeo link, or a direct MP4 URL. Leave blank for no video.</span>
                <span asp-validation-for="VideoUrl" class="text-danger"></span>
            </div>
        </div></div>

        <div class="card-cms"><div class="card-cms__body">
            <h3 class="section-title">Cover image</h3>
            <div class="img-upload" style="margin-bottom:8px">
                <img id="coverPreview" class="img-upload__preview" style="object-fit:cover;aspect-ratio:4/5" src="@preview" alt="" />
                <div>
                    <label class="btn-ghost" for="CoverImageFile"><i class="bi bi-upload"></i> Choose image</label>
                    <input class="d-none" type="file" asp-for="CoverImageFile" accept="image/*" data-preview="#coverPreview" />
                    <div class="hint">Portrait works best. @if (!string.IsNullOrEmpty(Model.CoverImage)) { <span>Current: @Model.CoverImage</span> }</div>
                    <span asp-validation-for="CoverImageFile" class="text-danger"></span>
                </div>
            </div>

            <hr style="border-color:var(--a-line)" />
            <h3 class="section-title">Options</h3>
            <div class="form-row"><label asp-for="Type"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<BardeesCms.Web.Models.Enums.AbayaType>()" class="form-select"></select>
            </div>
            <div class="form-row"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center;margin-top:14px"><label class="switch"><input asp-for="IsFeatured" /><span class="switch__slider"></span></label> <span>Featured</span></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center"><label class="switch"><input asp-for="IsActive" /><span class="switch__slider"></span></label> <span>Active (visible)</span></div>
            <div style="display:flex;gap:10px;margin-top:22px">
                <button type="submit" class="btn-gold"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div></div>
    </div>

    @* ---- Gallery (full width) ---------------------------------------------- *@
    <div class="card-cms" style="margin-top:20px"><div class="card-cms__body">
        <h3 class="section-title">Gallery</h3>
        @if (isNew)
        {
            <p class="hint">Save the abaya first, then add gallery images here.</p>
        }
        <div class="form-row">
            <label asp-for="GalleryFiles"></label>
            <input type="file" asp-for="GalleryFiles" accept="image/*" multiple class="form-control" />
            <span class="hint">Upload one or more images; they appear in the gallery on the detail page.</span>
        </div>
    </div></div>
</form>

@if (!isNew && Model.Images.Any())
{
    @Html.AntiForgeryToken()
    <div class="card-cms" style="margin-top:20px"><div class="card-cms__body">
        <h3 class="section-title">Current gallery <span class="hint">— drag to reorder</span></h3>
        <div class="gallery-grid" data-sortable="@Url.Action("ReorderImages")" style="display:flex;flex-wrap:wrap;gap:14px;margin-top:10px">
            @foreach (var m in Model.Images)
            {
                <div class="gallery-thumb" data-id="@m.Id" style="position:relative;width:130px">
                    <i class="bi bi-grip-vertical drag-handle" style="position:absolute;top:6px;left:6px;cursor:grab;background:rgba(0,0,0,.55);padding:2px 4px;border-radius:4px"></i>
                    <img src="@m.FilePath" alt="@m.AltText" style="width:130px;height:130px;object-fit:cover;border-radius:8px;display:block" />
                    <button type="button" class="btn-icon" data-delete-url="@Url.Action("DeleteImage", new { id = m.Id })" data-delete-name="this image" title="Remove" style="position:absolute;top:6px;right:6px;background:rgba(0,0,0,.55)"><i class="bi bi-trash"></i></button>
                </div>
            }
        </div>
    </div></div>
}

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
