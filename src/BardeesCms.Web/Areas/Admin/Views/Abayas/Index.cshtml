@model List<Abaya>
@{
    ViewData["Title"] = "Abayas";
    var result = (PagedResult<Abaya>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Abayas", Subtitle = "Bardees Abaya Collection — designs shown on the /abayas page.", ActionText = "New abaya", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()
<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i><input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search abayas…" /></div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="hidden" selected="@(result.Filter == "hidden")">Hidden</option>
        <option value="featured" selected="@(result.Filter == "featured")">Featured</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms"><div class="card-cms__body" style="padding:0">
    @if (Model.Any())
    {
        <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
            <thead><tr>
                @if (canReorder) { <th style="width:34px"></th> }
                <th style="width:80px">Preview</th><th>Name</th>
                <th class="d-none d-md-table-cell" style="width:150px">Type</th>
                <th style="width:90px">Featured</th><th style="width:90px">Active</th>
                <th style="width:120px;text-align:right">Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var a in Model)
            {
                var img = BardeesCms.Web.Services.ImageResolver.Src(a.CoverImage, "sq");
                <tr data-id="@a.Id">
                    @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                    <td data-label="Preview">
                        @if (!string.IsNullOrEmpty(img)) { <img class="thumb" style="width:64px;aspect-ratio:4/5;object-fit:cover" src="@img" alt="@a.Name" /> }
                        else { <span class="thumb" style="width:64px;display:grid;place-items:center"><i class="bi bi-image" style="color:var(--a-muted)"></i></span> }
                    </td>
                    <td data-label="Name"><a class="cell-title" asp-action="Edit" asp-route-id="@a.Id">@a.Name</a><div class="cell-ar">@a.NameAr</div></td>
                    <td data-label="Type" class="d-none d-md-table-cell"><span class="badge-cms">@(a.Type == AbayaType.ReadyToWear ? "Ready to Wear" : "Custom")</span></td>
                    <td data-label="Featured">@if (a.IsFeatured) { <span class="badge-cms badge-featured"><i class="bi bi-star-fill"></i></span> } else { <span style="color:var(--a-muted)">—</span> }</td>
                    <td data-label="Active"><label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = a.Id })" @(a.IsActive ? "checked" : "") /><span class="switch__slider"></span></label></td>
                    <td data-label="Actions"><div class="row-actions">
                        <a class="btn-icon" asp-action="Edit" asp-route-id="@a.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = a.Id })" data-delete-name="@a.Name" title="Delete"><i class="bi bi-trash"></i></button>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="bi bi-bag-heart"></i><h3>No abayas yet</h3><a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New abaya</a></div> }
</div></div>

<partial name="_Pager" model="pager" />
