@model List<PageSection>
@{
    ViewData["Title"] = "Page sections";
    var result = (PagedResult<PageSection>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Page sections", Subtitle = "Editable heading blocks (eyebrow + title + note) for the public site.", ActionText = "New section", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()

<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i>
        <input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search sections…" />
    </div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="inactive" selected="@(result.Filter == "inactive")">Inactive</option>
    </select>
    <select class="form-select" style="max-width:180px" name="sort" onchange="this.form.submit()">
        <option value="">Manual order</option>
        <option value="title" selected="@(result.Sort == "title")">Key A–Z</option>
        <option value="recent" selected="@(result.Sort == "recent")">Newest</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms">
    <div class="card-cms__body" style="padding:0">
        @if (Model.Any())
        {
            <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
                <thead>
                    <tr>
                        @if (canReorder) { <th style="width:34px"></th> }
                        <th style="width:56px">#</th>
                        <th>Section</th>
                        <th class="d-none d-md-table-cell">Page</th>
                        <th style="width:80px">Active</th>
                        <th style="width:120px;text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr data-id="@p.Id">
                            @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                            <td data-label="#"><span style="color:var(--a-gold-2);font-family:var(--a-serif)">@((p.DisplayOrder + 1).ToString("00"))</span></td>
                            <td data-label="Section">
                                <a class="cell-title" asp-action="Edit" asp-route-id="@p.Id"><code>@p.Key</code></a>
                                @if (!string.IsNullOrEmpty(p.Title)) { <div style="font-size:.78rem;color:var(--a-muted);max-width:52ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@Html.Raw(p.Title)</div> }
                            </td>
                            <td data-label="Page" class="d-none d-md-table-cell">@p.Page</td>
                            <td data-label="Active">
                                <label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = p.Id })" @(p.IsActive ? "checked" : "") /><span class="switch__slider"></span></label>
                            </td>
                            <td data-label="Actions">
                                <div class="row-actions">
                                    <a class="btn-icon" asp-action="Edit" asp-route-id="@p.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = p.Id })" data-delete-name="@p.Key" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><i class="bi bi-layout-text-window"></i><h3>No sections found</h3><p>Create your first page section to get started.</p>
                <a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New section</a></div>
        }
    </div>
</div>

<partial name="_Pager" model="pager" />
