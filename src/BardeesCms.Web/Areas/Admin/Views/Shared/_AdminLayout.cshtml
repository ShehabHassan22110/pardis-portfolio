@{
    var title = ViewData["Title"] as string ?? "Dashboard";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@title · BARDEES CMS</title>
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" type="image/svg+xml" href="/assets/brand/favicon.svg" />
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link href="~/admin/css/admin.css" asp-append-version="true" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-shell">
        <div class="admin-backdrop" id="adminBackdrop"></div>
        <partial name="_Sidebar" />

        <div class="admin-main">
            <header class="admin-topbar">
                <button class="admin-burger" id="adminBurger" aria-label="Toggle menu"><i class="bi bi-list"></i></button>
                <div class="admin-topbar__title">
                    <span class="admin-topbar__eyebrow">BARDEES CMS</span>
                    <h1>@title</h1>
                </div>
                <div class="admin-topbar__actions">
                    <a class="btn btn-ghost" href="/" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i><span class="d-none d-sm-inline"> View website</span></a>
                    <div class="admin-user">
                        <span class="admin-user__avatar">@((User.Identity?.Name ?? "A").Substring(0, 1).ToUpper())</span>
                        <span class="admin-user__name d-none d-md-inline">@User.Identity?.Name</span>
                        <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/" method="post" class="m-0">
                            <button type="submit" class="btn btn-ghost btn-sm" title="Logout"><i class="bi bi-box-arrow-right"></i></button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @{ var flash = TempData["FlashMessage"] as string; var flashType = TempData["FlashType"] as string ?? "success"; }
                @if (!string.IsNullOrEmpty(flash))
                {
                    <div class="admin-alert admin-alert--@flashType" data-autohide><i class="bi bi-check-circle"></i> @flash</div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script src="~/admin/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
