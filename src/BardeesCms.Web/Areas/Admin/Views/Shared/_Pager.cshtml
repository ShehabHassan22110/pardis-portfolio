@model BardeesCms.Web.Areas.Admin.Models.PagerModel
@if (Model.TotalItems > 0)
{
    IDictionary<string, string?> RV(int page)
    {
        var d = new Dictionary<string, string?>(Model.RouteValues) { ["page"] = page.ToString() };
        return d;
    }
    <div class="pager">
        <span class="pager__info">Showing @Model.FirstItem–@Model.LastItem of @Model.TotalItems</span>
        @if (Model.TotalPages > 1)
        {
            <div class="pager__links">
                @if (Model.Page > 1)
                {
                    <a asp-action="@Model.Action" asp-all-route-data="RV(Model.Page - 1)"><i class="bi bi-chevron-left"></i></a>
                }
                else { <span class="disabled"><i class="bi bi-chevron-left"></i></span> }

                @for (var p = Math.Max(1, Model.Page - 2); p <= Math.Min(Model.TotalPages, Model.Page + 2); p++)
                {
                    if (p == Model.Page) { <span class="current">@p</span> }
                    else { <a asp-action="@Model.Action" asp-all-route-data="RV(p)">@p</a> }
                }

                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="@Model.Action" asp-all-route-data="RV(Model.Page + 1)"><i class="bi bi-chevron-right"></i></a>
                }
                else { <span class="disabled"><i class="bi bi-chevron-right"></i></span> }
            </div>
        }
    </div>
}
