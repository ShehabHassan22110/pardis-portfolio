@model VideoFormVm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New video" : "Edit video";
    var header = new PageHeaderModel { Title = (string)ViewData["Title"]!, Subtitle = isNew ? "Add a showreel or campaign film." : Model.Title };
    var categories = ViewBag.Categories as List<VideoCategory> ?? new List<VideoCategory>();
}
<partial name="_PageHeader" model="header" />

<form asp-action="@(isNew ? "Create" : "Edit")" method="post" enctype="multipart/form-data" class="form-cms">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="VideoFile" />
    <input type="hidden" asp-for="Thumbnail" />
    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

    <div class="editor-layout">
        <div class="card-cms"><div class="card-cms__body">
            <div class="field-pair">
                <div class="form-row"><label asp-for="Title" class="lang-tag">EN</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                <div class="form-row"><label asp-for="TitleAr" class="lang-tag">AR</label><input asp-for="TitleAr" class="form-control" dir="rtl" /></div>
            </div>
            <div class="field-pair">
                <div class="form-row"><label asp-for="Client" class="lang-tag">Client · EN</label><input asp-for="Client" class="form-control" /></div>
                <div class="form-row"><label asp-for="ClientAr" class="lang-tag">Client · AR</label><input asp-for="ClientAr" class="form-control" dir="rtl" /></div>
            </div>
            <div class="field-pair">
                <div class="form-row"><label asp-for="Description" class="lang-tag">About · EN</label><textarea asp-for="Description" class="form-control" style="min-height:80px"></textarea></div>
                <div class="form-row"><label asp-for="DescriptionAr" class="lang-tag">About · AR</label><textarea asp-for="DescriptionAr" class="form-control" dir="rtl" style="min-height:80px"></textarea></div>
            </div>

            <hr style="border-color:var(--a-line)" />
            <h3 class="section-title">Source</h3>
            <div class="form-row"><label asp-for="Provider"></label><select asp-for="Provider" asp-items="Html.GetEnumSelectList<VideoProvider>()" class="form-select"></select></div>
            <div class="form-row"><label asp-for="VideoUrl"></label><input asp-for="VideoUrl" class="form-control" placeholder="https://youtu.be/… or https://vimeo.com/…" /><span asp-validation-for="VideoUrl" class="text-danger"></span></div>
            <div class="form-row"><label asp-for="ProviderVideoId"></label><input asp-for="ProviderVideoId" class="form-control" placeholder="Auto-parsed from URL if blank" /></div>

            <div class="img-upload" style="margin-top:12px">
                <span class="thumb" style="width:64px;display:grid;place-items:center"><i class="bi bi-film" style="color:var(--a-muted)"></i></span>
                <div>
                    <label class="btn-ghost" for="VideoFileUpload"><i class="bi bi-upload"></i> Upload MP4</label>
                    <input class="d-none" type="file" asp-for="VideoFileUpload" accept="video/*" />
                    <div class="hint">Only used when provider is MP4. @if (!string.IsNullOrEmpty(Model.VideoFile)) { <span>Current: @Model.VideoFile</span> }</div>
                    <span asp-validation-for="VideoFileUpload" class="text-danger"></span>
                </div>
            </div>
        </div></div>

        <div class="card-cms"><div class="card-cms__body">
            <h3 class="section-title">Thumbnail</h3>
            <div class="img-upload" style="margin-bottom:8px">
                <img id="thumbPreview" class="img-upload__preview" style="object-fit:cover" src="@(string.IsNullOrEmpty(Model.Thumbnail) ? "" : Model.Thumbnail)" alt="" />
                <div>
                    <label class="btn-ghost" for="ThumbnailFile"><i class="bi bi-upload"></i> Choose image</label>
                    <input class="d-none" type="file" asp-for="ThumbnailFile" accept="image/*" data-preview="#thumbPreview" />
                    <div class="hint">Falls back to the YouTube poster if left blank.</div>
                    <span asp-validation-for="ThumbnailFile" class="text-danger"></span>
                </div>
            </div>

            <hr style="border-color:var(--a-line)" />
            <h3 class="section-title">Options</h3>
            <div class="form-row"><label asp-for="VideoCategoryId"></label>
                <select asp-for="VideoCategoryId" class="form-select">
                    <option value="">— None —</option>
                    @foreach (var c in categories) { <option value="@c.Id" selected="@(Model.VideoCategoryId == c.Id)">@c.Name</option> }
                </select>
            </div>
            <div class="form-row"><label asp-for="Duration"></label><input asp-for="Duration" class="form-control" placeholder="e.g. 1:24" /></div>
            <div class="form-row"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center;margin-top:14px"><label class="switch"><input asp-for="IsPortrait" /><span class="switch__slider"></span></label> <span>Portrait (vertical)</span></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center"><label class="switch"><input asp-for="IsFeatured" /><span class="switch__slider"></span></label> <span>Featured</span></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center"><label class="switch"><input asp-for="IsPublished" /><span class="switch__slider"></span></label> <span>Published</span></div>
            <div style="display:flex;gap:10px;margin-top:22px">
                <button type="submit" class="btn-gold"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div></div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
