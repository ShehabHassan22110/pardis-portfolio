@model List<DisciplineListItem>
@{
    ViewData["Title"] = "Disciplines";
    var result = (PagedResult<DisciplineListItem>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Disciplines", Subtitle = "Content categories — each has its own detail page and portfolio projects.", ActionText = "New discipline", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()
<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i><input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search disciplines…" /></div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="inactive" selected="@(result.Filter == "inactive")">Inactive</option>
    </select>
    <select class="form-select" style="max-width:180px" name="sort" onchange="this.form.submit()">
        <option value="">Manual order</option>
        <option value="name" selected="@(result.Sort == "name")">Name A–Z</option>
        <option value="recent" selected="@(result.Sort == "recent")">Newest</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms"><div class="card-cms__body" style="padding:0">
    @if (Model.Any())
    {
        <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
            <thead><tr>
                @if (canReorder) { <th style="width:34px"></th> }
                <th style="width:64px">Cover</th>
                <th>Discipline</th>
                <th style="width:90px">Status</th>
                <th class="d-none d-md-table-cell" style="width:90px">Projects</th>
                <th style="width:80px">Active</th>
                <th style="width:120px;text-align:right">Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var row in Model)
            {
                var d = row.Discipline;
                <tr data-id="@d.Id">
                    @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                    <td data-label="Cover">
                        @if (!string.IsNullOrEmpty(d.CoverImage)) { <img class="thumb" src="@d.CoverImage" alt="@d.Name" /> }
                        else { <span class="thumb" style="display:grid;place-items:center"><i class="bi bi-collection" style="color:var(--a-muted)"></i></span> }
                    </td>
                    <td data-label="Discipline">
                        <a class="cell-title" asp-action="Edit" asp-route-id="@d.Id">@d.Name</a>
                        <div class="cell-ar">@d.NameAr</div>
                    </td>
                    <td data-label="Status">
                        @if (d.Status == DisciplineStatus.Soon) { <span class="badge-cms badge-soon">Soon</span> } else { <span class="badge-cms">Live</span> }
                    </td>
                    <td data-label="Projects" class="d-none d-md-table-cell"><span style="color:var(--a-muted)">@row.ProjectCount</span></td>
                    <td data-label="Active"><label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = d.Id })" @(d.IsActive ? "checked" : "") /><span class="switch__slider"></span></label></td>
                    <td data-label="Actions"><div class="row-actions">
                        <a class="btn-icon" asp-action="Edit" asp-route-id="@d.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = d.Id })" data-delete-name="@d.Name" title="Delete"><i class="bi bi-trash"></i></button>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="bi bi-collection"></i><h3>No disciplines yet</h3><a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New discipline</a></div> }
</div></div>

<partial name="_Pager" model="pager" />
