@model NavigationFormVm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New navigation link" : "Edit navigation link";
    var header = new PageHeaderModel { Title = (string)ViewData["Title"]!, Subtitle = isNew ? "Add a header or footer link." : Model.Title };
}
<partial name="_PageHeader" model="header" />

<form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="form-cms">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

    <div class="editor-layout">
        <div class="card-cms"><div class="card-cms__body">
            <div class="field-pair">
                <div class="form-row"><label asp-for="Title" class="lang-tag">EN</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                <div class="form-row"><label asp-for="TitleAr" class="lang-tag">AR</label><input asp-for="TitleAr" class="form-control" dir="rtl" /></div>
            </div>
            <div class="form-row">
                <label asp-for="Url"></label>
                <input asp-for="Url" class="form-control" placeholder="/about or https://…" />
                <span class="hint">Relative path (e.g. <strong>/services</strong>) or a full external URL.</span>
                <span asp-validation-for="Url" class="text-danger"></span>
            </div>
            <div class="field-pair">
                <div class="form-row"><label asp-for="Group" class="lang-tag">Group · EN</label><input asp-for="Group" class="form-control" placeholder="e.g. Explore" /><span class="hint">Footer column heading (optional).</span></div>
                <div class="form-row"><label asp-for="GroupAr" class="lang-tag">Group · AR</label><input asp-for="GroupAr" class="form-control" dir="rtl" /></div>
            </div>
        </div></div>

        <div class="card-cms"><div class="card-cms__body">
            <h3 class="section-title">Options</h3>
            <div class="form-row">
                <label asp-for="Location"></label>
                <select asp-for="Location" asp-items="Html.GetEnumSelectList<NavLocation>()" class="form-select"></select>
            </div>
            <div class="form-row">
                <label asp-for="Target"></label>
                <select asp-for="Target" class="form-select">
                    <option value="_self">Same tab (_self)</option>
                    <option value="_blank">New tab (_blank)</option>
                </select>
            </div>
            <div class="form-row"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center;margin-top:18px">
                <label class="switch"><input asp-for="IsActive" /><span class="switch__slider"></span></label> <span>Active</span>
            </div>
            <div style="display:flex;gap:10px;margin-top:22px">
                <button type="submit" class="btn-gold"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div></div>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
