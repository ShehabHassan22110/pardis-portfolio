@model AboutFormVm
@{
    ViewData["Title"] = "About section";
    var header = new PageHeaderModel { Title = "About section", Subtitle = "Feature block and key facts." };
    var facts = Model.Facts ?? new List<AboutFactVm>();
    var rowCount = facts.Count + 3;
}
<partial name="_PageHeader" model="header" />

<form asp-action="Index" method="post" enctype="multipart/form-data" class="form-cms">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Image" />
    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

    <div class="card-cms"><div class="card-cms__body">
        <h3 class="section-title">Content</h3>
        <div class="field-pair">
            <div class="form-row"><label asp-for="Eyebrow" class="lang-tag">Eyebrow · EN</label><input asp-for="Eyebrow" class="form-control" /></div>
            <div class="form-row"><label asp-for="EyebrowAr" class="lang-tag">Eyebrow · AR</label><input asp-for="EyebrowAr" class="form-control" dir="rtl" /></div>
        </div>
        <div class="field-pair">
            <div class="form-row"><label asp-for="Title" class="lang-tag">Title · EN</label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
            <div class="form-row"><label asp-for="TitleAr" class="lang-tag">Title · AR</label><input asp-for="TitleAr" class="form-control" dir="rtl" /></div>
        </div>
        <div class="field-pair">
            <div class="form-row"><label asp-for="Description" class="lang-tag">Description · EN</label><textarea asp-for="Description" class="form-control" style="min-height:80px"></textarea></div>
            <div class="form-row"><label asp-for="DescriptionAr" class="lang-tag">Description · AR</label><textarea asp-for="DescriptionAr" class="form-control" dir="rtl" style="min-height:80px"></textarea></div>
        </div>
        <div class="field-pair">
            <div class="form-row"><label asp-for="LongDescription" class="lang-tag">Long · EN</label><textarea asp-for="LongDescription" class="form-control" style="min-height:140px"></textarea></div>
            <div class="form-row"><label asp-for="LongDescriptionAr" class="lang-tag">Long · AR</label><textarea asp-for="LongDescriptionAr" class="form-control" dir="rtl" style="min-height:140px"></textarea></div>
        </div>
    </div></div>

    <div class="card-cms"><div class="card-cms__body">
        <h3 class="section-title">Image, location &amp; quote</h3>
        <div class="img-upload" style="margin-bottom:8px">
            <img id="aboutPreview" class="img-upload__preview" src="@(string.IsNullOrEmpty(Model.Image) ? "" : Model.Image)" alt="" />
            <div>
                <label class="btn-ghost" for="ImageFile"><i class="bi bi-upload"></i> Choose image</label>
                <input class="d-none" type="file" asp-for="ImageFile" accept="image/*" data-preview="#aboutPreview" />
                <div class="hint">Portrait or editorial shot. Max 8 MB.</div>
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>
        </div>
        <div class="field-pair">
            <div class="form-row"><label asp-for="Location" class="lang-tag">Location · EN</label><input asp-for="Location" class="form-control" /></div>
            <div class="form-row"><label asp-for="LocationAr" class="lang-tag">Location · AR</label><input asp-for="LocationAr" class="form-control" dir="rtl" /></div>
        </div>
        <div class="field-pair">
            <div class="form-row"><label asp-for="Quote" class="lang-tag">Quote · EN</label><textarea asp-for="Quote" class="form-control" style="min-height:80px"></textarea></div>
            <div class="form-row"><label asp-for="QuoteAr" class="lang-tag">Quote · AR</label><textarea asp-for="QuoteAr" class="form-control" dir="rtl" style="min-height:80px"></textarea></div>
        </div>
    </div></div>

    <div class="card-cms"><div class="card-cms__body">
        <h3 class="section-title">Button</h3>
        <div class="field-pair">
            <div class="form-row"><label asp-for="ButtonText" class="lang-tag">Button · EN</label><input asp-for="ButtonText" class="form-control" /></div>
            <div class="form-row"><label asp-for="ButtonTextAr" class="lang-tag">Button · AR</label><input asp-for="ButtonTextAr" class="form-control" dir="rtl" /></div>
        </div>
        <div class="form-row"><label asp-for="ButtonUrl"></label><input asp-for="ButtonUrl" class="form-control" placeholder="/about" /></div>
        <div class="form-row" style="display:flex;gap:20px;align-items:center;margin-top:14px"><label class="switch"><input asp-for="IsActive" /><span class="switch__slider"></span></label> <span>Active</span></div>
    </div></div>

    <div class="card-cms"><div class="card-cms__body">
        <h3 class="section-title">Facts</h3>
        <p class="hint">Rows left blank are ignored on save.</p>
        <table class="table-cms">
            <thead>
                <tr><th>Label EN</th><th>Label AR</th><th>Value EN</th><th>Value AR</th><th style="width:90px">Order</th></tr>
            </thead>
            <tbody>
                @for (var i = 0; i < rowCount; i++)
                {
                    var f = i < facts.Count ? facts[i] : new AboutFactVm();
                    <tr>
                        <td>
                            <input type="hidden" name="Facts[@i].Id" value="@f.Id" />
                            <input name="Facts[@i].Label" value="@f.Label" class="form-control" />
                        </td>
                        <td><input name="Facts[@i].LabelAr" value="@f.LabelAr" class="form-control" dir="rtl" /></td>
                        <td><input name="Facts[@i].Value" value="@f.Value" class="form-control" /></td>
                        <td><input name="Facts[@i].ValueAr" value="@f.ValueAr" class="form-control" dir="rtl" /></td>
                        <td><input name="Facts[@i].DisplayOrder" value="@f.DisplayOrder" type="number" class="form-control" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>

    <div style="display:flex;gap:10px;margin-top:22px">
        <button type="submit" class="btn-gold"><i class="bi bi-check-lg"></i> Save</button>
    </div>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
