@model List<MediaAsset>
@{
    ViewData["Title"] = "Media Library";
    var result = (PagedResult<MediaAsset>)ViewBag.Result;
    var header = new PageHeaderModel { Title = "Media Library", Subtitle = "Reusable images, videos and documents. Upload once, reference anywhere." };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["filter"] = result.Filter } };

    string HumanSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes; var u = 0;
        while (size >= 1024 && u < units.Length - 1) { size /= 1024; u++; }
        return $"{size:0.#} {units[u]}";
    }
}
@Html.AntiForgeryToken()
<partial name="_PageHeader" model="header" />

<form asp-action="Upload" method="post" enctype="multipart/form-data" class="form-cms" style="margin-bottom:18px">
    @Html.AntiForgeryToken()
    <div class="card-cms"><div class="card-cms__body">
        <div class="dropzone" data-dropzone-for="#mediaFiles" style="cursor:pointer;text-align:center;padding:26px;border:1.5px dashed var(--a-line);border-radius:12px">
            <i class="bi bi-cloud-arrow-up" style="font-size:2rem;color:var(--a-gold-2)"></i>
            <div style="margin-top:8px">Drag files here or <strong>click to browse</strong></div>
            <div class="hint">Images, video and documents. You can select multiple files.</div>
        </div>
        <input class="d-none" type="file" id="mediaFiles" name="files" multiple />
        <div style="display:flex;gap:10px;margin-top:14px">
            <button type="submit" class="btn-gold"><i class="bi bi-upload"></i> Upload</button>
        </div>
    </div></div>
</form>

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i><input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search files…" /></div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All types</option>
        <option value="Image" selected="@(result.Filter == "Image")">Images</option>
        <option value="Video" selected="@(result.Filter == "Video")">Videos</option>
        <option value="Document" selected="@(result.Filter == "Document")">Documents</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

@if (Model.Any())
{
    <div class="media-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px">
        @foreach (var m in Model)
        {
            <div class="card-cms" data-id="@m.Id"><div class="card-cms__body" style="padding:12px">
                <div style="aspect-ratio:4/3;background:var(--a-bg-2, #111);border-radius:8px;overflow:hidden;display:grid;place-items:center;margin-bottom:10px">
                    @if (m.MediaType == MediaType.Image)
                    {
                        <img src="@(string.IsNullOrEmpty(m.ThumbnailPath) ? m.FilePath : m.ThumbnailPath)" alt="@(m.AltText ?? m.OriginalFileName)" loading="lazy" style="width:100%;height:100%;object-fit:cover" />
                    }
                    else if (m.MediaType == MediaType.Video)
                    {
                        <i class="bi bi-film" style="font-size:2.4rem;color:var(--a-muted)"></i>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-text" style="font-size:2.4rem;color:var(--a-muted)"></i>
                    }
                </div>
                <div class="cell-title" style="font-size:.82rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="@(m.OriginalFileName ?? m.FileName)">@(m.OriginalFileName ?? m.FileName)</div>
                <div class="hint" style="margin-top:2px">
                    @HumanSize(m.FileSize)@(m.Width.HasValue && m.Height.HasValue ? $" · {m.Width}×{m.Height}" : "")
                </div>
                <div class="row-actions" style="margin-top:10px;display:flex;gap:6px">
                    <button type="button" class="btn-ghost btn-copy-url" data-url="@m.FilePath" style="font-size:.78rem;padding:4px 8px"><i class="bi bi-clipboard"></i> Copy</button>
                    <a class="btn-icon" asp-action="Edit" asp-route-id="@m.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = m.Id })" data-delete-name="@(m.OriginalFileName ?? m.FileName)" title="Delete"><i class="bi bi-trash"></i></button>
                </div>
            </div></div>
        }
    </div>
}
else
{
    <div class="card-cms"><div class="card-cms__body">
        <div class="empty-state"><i class="bi bi-images"></i><h3>No media yet</h3><p>Upload your first file using the box above.</p></div>
    </div></div>
}

<partial name="_Pager" model="pager" />

@section Scripts {
    <script>
        document.querySelectorAll(".btn-copy-url").forEach(function (btn) {
            btn.addEventListener("click", function () {
                var url = new URL(btn.dataset.url, window.location.origin).href;
                navigator.clipboard.writeText(url).then(function () {
                    var original = btn.innerHTML;
                    btn.innerHTML = '<i class="bi bi-check-lg"></i> Copied';
                    setTimeout(function () { btn.innerHTML = original; }, 1500);
                });
            });
        });
    </script>
}
