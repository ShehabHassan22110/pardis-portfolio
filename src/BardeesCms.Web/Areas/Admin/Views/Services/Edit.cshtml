@model ServiceFormVm
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "New service" : "Edit service";
    var header = new PageHeaderModel { Title = (string)ViewData["Title"]!, Subtitle = isNew ? "Add a new service offering." : Model.Title };
}

<partial name="_PageHeader" model="header" />

<form asp-action="@(isNew ? "Create" : "Edit")" method="post" class="form-cms" enctype="multipart/form-data">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="Image" />
    <div asp-validation-summary="ModelOnly" class="admin-alert admin-alert--danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "flex")"></div>

    <div class="editor-layout">
        <div class="card-cms"><div class="card-cms__body">
            <div class="field-pair">
                <div class="form-row"><label asp-for="Title" class="lang-tag">EN</label><input asp-for="Title" class="form-control" data-slug-source="#Slug" /><span asp-validation-for="Title" class="text-danger"></span></div>
                <div class="form-row"><label asp-for="TitleAr" class="lang-tag">AR</label><input asp-for="TitleAr" class="form-control" dir="rtl" /></div>
            </div>
            <div class="form-row">
                <label asp-for="Slug"></label>
                <input asp-for="Slug" id="Slug" class="form-control" placeholder="auto-generated from title" />
                <span class="hint">Used in the URL: /services/<strong>your-slug</strong>. Leave blank to auto-generate.</span>
                <span asp-validation-for="Slug" class="text-danger"></span>
            </div>
            <div class="field-pair">
                <div class="form-row"><label asp-for="ShortDescription" class="lang-tag">Short · EN</label><textarea asp-for="ShortDescription" class="form-control" style="min-height:80px"></textarea></div>
                <div class="form-row"><label asp-for="ShortDescriptionAr" class="lang-tag">Short · AR</label><textarea asp-for="ShortDescriptionAr" class="form-control" dir="rtl" style="min-height:80px"></textarea></div>
            </div>
            <div class="field-pair">
                <div class="form-row"><label asp-for="Description" class="lang-tag">Full · EN</label><textarea asp-for="Description" class="form-control"></textarea></div>
                <div class="form-row"><label asp-for="DescriptionAr" class="lang-tag">Full · AR</label><textarea asp-for="DescriptionAr" class="form-control" dir="rtl"></textarea></div>
            </div>
        </div></div>

        <div class="card-cms"><div class="card-cms__body">
            <h3 class="section-title">Image</h3>
            <div class="img-upload" style="margin-bottom:8px">
                <img id="imagePreview" class="img-upload__preview" style="object-fit:cover" src="@ImageResolver.Src(Model.Image, "sq")" alt="" />
                <div>
                    <label class="btn-ghost" for="ImageFile"><i class="bi bi-upload"></i> Choose image</label>
                    <input class="d-none" type="file" asp-for="ImageFile" accept="image/*" data-preview="#imagePreview" />
                    <div class="hint">Max 8 MB. Shown on the service detail page.</div>
                    <span asp-validation-for="ImageFile" class="text-danger"></span>
                </div>
            </div>
            <hr style="border-color:var(--a-line)" />
            <h3 class="section-title">Options</h3>
            <div class="form-row"><label asp-for="Number"></label><input asp-for="Number" class="form-control" placeholder="01" /></div>
            <div class="form-row"><label asp-for="Icon"></label><input asp-for="Icon" class="form-control" placeholder="e.g. bi-camera" /></div>
            <div class="form-row"><label asp-for="DisplayOrder"></label><input asp-for="DisplayOrder" type="number" class="form-control" /></div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center;margin-top:18px">
                <label class="switch"><input asp-for="IsFeatured" /><span class="switch__slider"></span></label> <span>Featured</span>
            </div>
            <div class="form-row" style="display:flex;gap:20px;align-items:center">
                <label class="switch"><input asp-for="IsActive" /><span class="switch__slider"></span></label> <span>Active</span>
            </div>
            <div style="display:flex;gap:10px;margin-top:22px">
                <button type="submit" class="btn-gold"><i class="bi bi-check-lg"></i> Save</button>
                <a class="btn-ghost" asp-action="Index">Cancel</a>
            </div>
        </div></div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
