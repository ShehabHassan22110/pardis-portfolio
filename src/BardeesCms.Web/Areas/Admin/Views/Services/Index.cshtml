@model List<Service>
@{
    ViewData["Title"] = "Services";
    var result = (PagedResult<Service>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Services", Subtitle = "What Bardees offers — shown on the homepage and services page.", ActionText = "New service", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()

<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i>
        <input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search services…" />
    </div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="inactive" selected="@(result.Filter == "inactive")">Inactive</option>
        <option value="featured" selected="@(result.Filter == "featured")">Featured</option>
    </select>
    <select class="form-select" style="max-width:180px" name="sort" onchange="this.form.submit()">
        <option value="">Manual order</option>
        <option value="title" selected="@(result.Sort == "title")">Title A–Z</option>
        <option value="recent" selected="@(result.Sort == "recent")">Newest</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms">
    <div class="card-cms__body" style="padding:0">
        @if (Model.Any())
        {
            <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
                <thead>
                    <tr>
                        @if (canReorder) { <th style="width:34px"></th> }
                        <th style="width:56px">#</th>
                        <th>Service</th>
                        <th class="d-none d-md-table-cell">Arabic</th>
                        <th style="width:90px">Featured</th>
                        <th style="width:80px">Active</th>
                        <th style="width:120px;text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr data-id="@s.Id">
                            @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                            <td data-label="#"><span style="color:var(--a-gold-2);font-family:var(--a-serif)">@(s.Number ?? (s.DisplayOrder + 1).ToString("00"))</span></td>
                            <td data-label="Service">
                                <a class="cell-title" asp-action="Edit" asp-route-id="@s.Id">@s.Title</a>
                                @if (!string.IsNullOrEmpty(s.ShortDescription)) { <div style="font-size:.78rem;color:var(--a-muted);max-width:42ch;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@s.ShortDescription</div> }
                            </td>
                            <td data-label="Arabic" class="cell-ar d-none d-md-table-cell">@s.TitleAr</td>
                            <td data-label="Featured">@if (s.IsFeatured) { <span class="badge-cms badge-featured"><i class="bi bi-star-fill"></i></span> } else { <span style="color:var(--a-muted)">—</span> }</td>
                            <td data-label="Active">
                                <label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = s.Id })" @(s.IsActive ? "checked" : "") /><span class="switch__slider"></span></label>
                            </td>
                            <td data-label="Actions">
                                <div class="row-actions">
                                    <a class="btn-icon" asp-action="Edit" asp-route-id="@s.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = s.Id })" data-delete-name="@s.Title" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><i class="bi bi-briefcase"></i><h3>No services found</h3><p>Create your first service to get started.</p>
                <a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New service</a></div>
        }
    </div>
</div>

<partial name="_Pager" model="pager" />
