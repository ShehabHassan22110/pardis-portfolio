@model List<PresenceStat>
@{
    ViewData["Title"] = "Presence Stats";
    var result = (PagedResult<PresenceStat>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Presence Stats", Subtitle = "Headline audience statistics shown in the digital-presence section.", ActionText = "New stat", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()
<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i><input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search stats…" /></div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="inactive" selected="@(result.Filter == "inactive")">Inactive</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms"><div class="card-cms__body" style="padding:0">
    @if (Model.Any())
    {
        <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
            <thead><tr>
                @if (canReorder) { <th style="width:34px"></th> }
                <th style="width:120px">Value</th><th>Label</th>
                <th style="width:80px">Active</th>
                <th style="width:120px;text-align:right">Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr data-id="@s.Id">
                    @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                    <td data-label="Value"><span style="color:var(--a-gold-2);font-family:var(--a-serif);font-size:1.1rem">@s.Value</span></td>
                    <td data-label="Label"><a class="cell-title" asp-action="Edit" asp-route-id="@s.Id">@s.Label</a><div class="cell-ar">@s.LabelAr</div></td>
                    <td data-label="Active"><label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = s.Id })" @(s.IsActive ? "checked" : "") /><span class="switch__slider"></span></label></td>
                    <td data-label="Actions"><div class="row-actions">
                        <a class="btn-icon" asp-action="Edit" asp-route-id="@s.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = s.Id })" data-delete-name="@s.Label" title="Delete"><i class="bi bi-trash"></i></button>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="bi bi-graph-up"></i><h3>No stats yet</h3><a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New stat</a></div> }
</div></div>

<partial name="_Pager" model="pager" />
