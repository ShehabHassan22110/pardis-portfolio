@model List<ContentStyle>
@{
    ViewData["Title"] = "Content styles";
    var result = (PagedResult<ContentStyle>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Content styles", Subtitle = "Style tag chips (e.g. Reels, Stories) shown on the public site.", ActionText = "New style", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()

<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i>
        <input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search styles…" />
    </div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="inactive" selected="@(result.Filter == "inactive")">Inactive</option>
    </select>
    <select class="form-select" style="max-width:180px" name="sort" onchange="this.form.submit()">
        <option value="">Manual order</option>
        <option value="title" selected="@(result.Sort == "title")">Name A–Z</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms">
    <div class="card-cms__body" style="padding:0">
        @if (Model.Any())
        {
            <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
                <thead>
                    <tr>
                        @if (canReorder) { <th style="width:34px"></th> }
                        <th style="width:56px">#</th>
                        <th>Style</th>
                        <th class="d-none d-md-table-cell">Arabic</th>
                        <th style="width:80px">Active</th>
                        <th style="width:120px;text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr data-id="@c.Id">
                            @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                            <td data-label="#"><span style="color:var(--a-gold-2);font-family:var(--a-serif)">@((c.DisplayOrder + 1).ToString("00"))</span></td>
                            <td data-label="Style">
                                <a class="cell-title" asp-action="Edit" asp-route-id="@c.Id">@c.Name</a>
                            </td>
                            <td data-label="Arabic" class="cell-ar d-none d-md-table-cell">@c.NameAr</td>
                            <td data-label="Active">
                                <label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = c.Id })" @(c.IsActive ? "checked" : "") /><span class="switch__slider"></span></label>
                            </td>
                            <td data-label="Actions">
                                <div class="row-actions">
                                    <a class="btn-icon" asp-action="Edit" asp-route-id="@c.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = c.Id })" data-delete-name="@c.Name" title="Delete"><i class="bi bi-trash"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state"><i class="bi bi-tags"></i><h3>No content styles found</h3><p>Create your first content style to get started.</p>
                <a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New style</a></div>
        }
    </div>
</div>

<partial name="_Pager" model="pager" />
