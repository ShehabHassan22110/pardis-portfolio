@model List<Brand>
@{
    ViewData["Title"] = "Clients & Brands";
    var result = (PagedResult<Brand>)ViewBag.Result;
    var canReorder = string.IsNullOrEmpty(result.Sort) && string.IsNullOrEmpty(result.Search);
    var header = new PageHeaderModel { Title = "Clients & Brands", Subtitle = "Ambassadorships and client relationships shown in the Clients carousel.", ActionText = "New client", ActionUrl = Url.Action("Create") };
    var pager = new PagerModel { Page = result.Page, TotalPages = result.TotalPages, TotalItems = result.TotalItems, FirstItem = result.FirstItem, LastItem = result.LastItem, RouteValues = new Dictionary<string, string?> { ["search"] = result.Search, ["sort"] = result.Sort, ["filter"] = result.Filter } };
}
@Html.AntiForgeryToken()
<partial name="_PageHeader" model="header" />

<form class="toolbar" method="get">
    <div class="search"><i class="bi bi-search"></i><input class="form-control" type="search" name="search" value="@result.Search" placeholder="Search clients…" /></div>
    <select class="form-select" style="max-width:180px" name="filter" onchange="this.form.submit()">
        <option value="">All</option>
        <option value="active" selected="@(result.Filter == "active")">Active</option>
        <option value="inactive" selected="@(result.Filter == "inactive")">Inactive</option>
        <option value="featured" selected="@(result.Filter == "featured")">Featured</option>
    </select>
    <button class="btn-ghost" type="submit"><i class="bi bi-funnel"></i> Filter</button>
</form>

<div class="card-cms"><div class="card-cms__body" style="padding:0">
    @if (Model.Any())
    {
        <table class="table-cms" data-sortable="@(canReorder ? Url.Action("Reorder") : null)">
            <thead><tr>
                @if (canReorder) { <th style="width:34px"></th> }
                <th style="width:64px">Logo</th><th>Client</th>
                <th class="d-none d-md-table-cell">Role · Sector</th>
                <th style="width:90px">Featured</th><th style="width:80px">Active</th>
                <th style="width:120px;text-align:right">Actions</th>
            </tr></thead>
            <tbody>
            @foreach (var b in Model)
            {
                <tr data-id="@b.Id">
                    @if (canReorder) { <td data-label=""><i class="bi bi-grip-vertical drag-handle"></i></td> }
                    <td data-label="Logo">
                        @if (!string.IsNullOrEmpty(b.Logo)) { <img class="thumb thumb--logo" src="@(ImageResolver.IsDirectPath(b.Logo) ? ImageResolver.Src(b.Logo) : $"/assets/img/{b.Logo}.png")" alt="@b.Name" /> }
                        else { <span class="thumb" style="display:grid;place-items:center"><i class="bi bi-patch-check" style="color:var(--a-muted)"></i></span> }
                    </td>
                    <td data-label="Client"><a class="cell-title" asp-action="Edit" asp-route-id="@b.Id">@b.Name</a><div class="cell-ar">@b.NameAr</div></td>
                    <td data-label="Role" class="d-none d-md-table-cell">@b.Role @(string.IsNullOrEmpty(b.Sector) ? "" : $"· {b.Sector}")</td>
                    <td data-label="Featured">@if (b.IsFeatured) { <span class="badge-cms badge-featured"><i class="bi bi-star-fill"></i></span> } else { <span style="color:var(--a-muted)">—</span> }</td>
                    <td data-label="Active"><label class="switch"><input type="checkbox" data-toggle-url="@Url.Action("Toggle", new { id = b.Id })" @(b.IsActive ? "checked" : "") /><span class="switch__slider"></span></label></td>
                    <td data-label="Actions"><div class="row-actions">
                        <a class="btn-icon" asp-action="Edit" asp-route-id="@b.Id" title="Edit"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn-icon" data-delete-url="@Url.Action("Delete", new { id = b.Id })" data-delete-name="@b.Name" title="Delete"><i class="bi bi-trash"></i></button>
                    </div></td>
                </tr>
            }
            </tbody>
        </table>
    }
    else { <div class="empty-state"><i class="bi bi-patch-check"></i><h3>No clients yet</h3><a class="btn-gold" style="margin-top:12px" asp-action="Create"><i class="bi bi-plus-lg"></i> New client</a></div> }
</div></div>

<partial name="_Pager" model="pager" />
