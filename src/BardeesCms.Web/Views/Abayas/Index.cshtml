@model AbayasViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Site.T("Abayas", "العبايات");
    var wa = (Model.WhatsApp ?? "").Trim();
    var heading = Model.Heading;

    // Order groups: Ready-to-Wear first, then Custom. Each renders only if it has designs.
    var groups = new (AbayaType Type, string En, string Ar, string NoteEn, string NoteAr)[]
    {
        (AbayaType.ReadyToWear, "Ready to Wear", "جاهزة للارتداء",
            "Finished designs, available as shown.", "تصاميم جاهزة متوفّرة كما تظهر."),
        (AbayaType.Custom, "Custom Tailoring", "تفصيل حسب الطلب",
            "Made to measure — choose fabric, colour and detailing.", "تفصيل حسب المقاس — اختاري الخامة واللون والتفاصيل."),
    };

    string RequestLink(Abaya a)
    {
        var name = Site.Pick(a.Name, a.NameAr);
        var msg = Site.T(
            $"Hello Bardees, I'd like to request the “{name}” abaya.",
            $"مرحباً برديس، أرغب في طلب عباية “{name}”.");
        return string.IsNullOrEmpty(wa) ? "/contact" : $"https://wa.me/{wa}?text={Uri.EscapeDataString(msg)}";
    }

    var ws = Model.Workshop;
    string WorkshopLink()
    {
        var msg = Site.Pick(ws?.WhatsAppMessage, ws?.WhatsAppMessageAr);
        if (string.IsNullOrWhiteSpace(msg))
            msg = Site.T("Hello Bardees, I'd like to attend one of your abaya workshops.",
                         "مرحباً برديس، أرغب في حضور إحدى ورش العبايات لديك.");
        return string.IsNullOrEmpty(wa) ? "/contact" : $"https://wa.me/{wa}?text={Uri.EscapeDataString(msg)}";
    }
}

<section class="section page-hero" id="abaya-collection">
    <div class="container">
        @if (heading is not null)
        {
            var h1ViewData = new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData) { { "AsH1", true } };
            <partial name="_SectionHeading" model="heading" view-data="h1ViewData" />
        }
        else
        {
            <div class="title-c reveal">
                <span class="tc-eyebrow">@Site.T("Bardees Abaya Collection", "مجموعة عبايات برديس")</span>
                <h1 class="d-1 tc-h">@Html.Raw(Site.T("Designed &amp; tailored by <em>Bardees</em>.", "تصميم وتفصيل <em>برديس</em>."))</h1>
                <p class="tc-note">@Site.T("A personal line of abayas — from ready-to-wear pieces to made-to-measure tailoring. Order directly over WhatsApp.", "خط عبايات خاص — من القطع الجاهزة إلى التفصيل حسب الطلب. اطلبي مباشرةً عبر واتساب.")</p>
            </div>
        }

        @* Attend a workshop — an animated invite under the hero title that opens the full detail in a modal *@
        @if (ws is not null)
        {
            var wsTitle = Site.Pick(ws.Title, ws.TitleAr);
            var wsEyebrow = Site.Pick(ws.Eyebrow, ws.EyebrowAr);
            var wsDesc = Site.Pick(ws.Description, ws.DescriptionAr);
            var wsSchedule = Site.Pick(ws.ScheduleText, ws.ScheduleTextAr);
            var wsLocation = Site.Pick(ws.LocationText, ws.LocationTextAr);
            var wsHighlights = (Site.Pick(ws.Highlights, ws.HighlightsAr) ?? "")
                .Split('\n').Select(h => h.Trim()).Where(h => h.Length > 0).ToList();
            var wsBtn = Site.Pick(ws.ButtonText, ws.ButtonTextAr);
            if (string.IsNullOrWhiteSpace(wsBtn)) { wsBtn = Site.T("Text me on WhatsApp", "راسليني على واتساب"); }
            var wsImg = ImageResolver.Src(ws.Image, "landscape");
            var wsInvite = Site.T("Join an abaya workshop", "احضري ورشة العبايات");

            <div class="ws-invite reveal" data-d="1">
                <button type="button" class="ws-trigger" data-bs-toggle="modal" data-bs-target="#workshopModal">
                    <span class="ws-trigger__aura" aria-hidden="true"></span>
                    <span class="ws-trigger__icon" aria-hidden="true"><i class="bi bi-scissors"></i></span>
                    <span class="ws-trigger__text">
                        <span class="ws-trigger__label">@(wsEyebrow ?? Site.T("Workshops", "ورش العمل"))</span>
                        <span class="ws-trigger__title">@wsInvite</span>
                    </span>
                    <span class="ws-trigger__go" aria-hidden="true"><i class="bi bi-arrow-@(Site.IsRtl ? "left" : "right")"></i></span>
                </button>
            </div>

            <div class="modal fade ws-modal" id="workshopModal" tabindex="-1" aria-labelledby="workshopModalTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content ws-modal__content">
                        <button type="button" class="ws-modal__close" data-bs-dismiss="modal" aria-label="@Site.T("Close", "إغلاق")"><i class="bi bi-x-lg"></i></button>
                        <div class="ws-modal__aside">
                            @if (!string.IsNullOrEmpty(wsImg))
                            {
                                <partial name="_Picture" model="@(new PictureVm { Image = ws.Image, Rendition = "landscape", Alt = wsTitle ?? "", Sizes = "(max-width: 720px) 100vw, 44vw" })" />
                            }
                            else
                            {
                                <span class="ws-modal__mono" aria-hidden="true">B</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(wsEyebrow)) { <span class="ws-modal__badge">@wsEyebrow</span> }
                        </div>
                        <div class="ws-modal__body">
                            <h2 class="ws-modal__title" id="workshopModalTitle">@(wsTitle ?? wsInvite)</h2>
                            @if (!string.IsNullOrWhiteSpace(wsDesc)) { <p class="ws-modal__desc">@wsDesc</p> }

                            @if (!string.IsNullOrWhiteSpace(wsSchedule) || !string.IsNullOrWhiteSpace(wsLocation))
                            {
                                <ul class="ws-modal__meta">
                                    @if (!string.IsNullOrWhiteSpace(wsSchedule)) { <li><i class="bi bi-calendar-event"></i> @wsSchedule</li> }
                                    @if (!string.IsNullOrWhiteSpace(wsLocation)) { <li><i class="bi bi-geo-alt"></i> @wsLocation</li> }
                                </ul>
                            }

                            @if (wsHighlights.Any())
                            {
                                <ul class="ws-modal__list">
                                    @foreach (var h in wsHighlights) { <li><i class="bi bi-check2-circle"></i> <span>@h</span></li> }
                                </ul>
                            }

                            <a class="btn btn-gold btn-lg ws-modal__cta" href="@WorkshopLink()" target="_blank" rel="noopener">
                                @wsBtn <i class="bi bi-whatsapp"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (!Model.Abayas.Any())
        {
            <div class="text-center py-5"><p class="tc-note">@Site.T("New designs are being added soon.", "تُضاف تصاميم جديدة قريباً.")</p></div>
        }

        @foreach (var g in groups)
        {
            var items = Model.Abayas.Where(a => a.Type == g.Type).ToList();
            if (!items.Any()) { continue; }
            <div class="abaya-group reveal">
                <div class="abaya-group__head">
                    <h3 class="abaya-group__title">@Site.T(g.En, g.Ar)</h3>
                    <p class="abaya-group__note">@Site.T(g.NoteEn, g.NoteAr)</p>
                </div>
                <div class="abaya-grid">
                    @foreach (var a in items)
                    {
                        var img = string.IsNullOrEmpty(a.CoverImage) ? a.ThumbnailImage : a.CoverImage;
                        var name = Site.Pick(a.Name, a.NameAr);
                        var fabric = Site.Pick(a.Fabric, a.FabricAr);
                        var pic = new PictureVm { Image = img, Rendition = "portrait", Alt = name ?? "" };
                        <figure class="abaya-card m-0">
                            <a class="abaya-card__img" href="/abayas/@a.Slug" aria-label="@name"><partial name="_Picture" model="pic" /></a>
                            <figcaption class="abaya-card__body">
                                <a class="abaya-card__name" href="/abayas/@a.Slug">@name</a>
                                @if (!string.IsNullOrEmpty(fabric)) { <span class="abaya-card__fabric">@fabric</span> }
                                <div class="abaya-card__actions">
                                    <a class="btn btn-gold btn-sm abaya-card__cta" href="@RequestLink(a)" target="_blank" rel="noopener">
                                        @Site.T("Request Order", "اطلبي التصميم") <i class="bi bi-whatsapp"></i>
                                    </a>
                                    <a class="abaya-card__more" href="/abayas/@a.Slug">@Site.T("Details", "التفاصيل") <i class="bi bi-arrow-@(Site.IsRtl ? "left" : "right")"></i></a>
                                </div>
                            </figcaption>
                        </figure>
                    }
                </div>
            </div>
        }

        @* How to order *@
        <div class="abaya-how reveal" data-d="1">
            <h3 class="abaya-how__title">@Site.T("How to order", "طريقة الطلب")</h3>
            <ol class="abaya-how__steps">
                <li>@Site.T("Browse the designs and tap “Request Order” on the piece you love.", "تصفّحي التصاميم واضغطي «اطلبي التصميم» على القطعة التي تعجبك.")</li>
                <li>@Site.T("Share your size, preferred colour and any custom detailing over WhatsApp.", "شاركي مقاسك واللون المفضّل وأي تفاصيل خاصة عبر واتساب.")</li>
                <li>@Site.T("Confirm the details and delivery — and it's on its way.", "أكّدي التفاصيل والتوصيل — وتكون في طريقها إليك.")</li>
            </ol>
            @if (!string.IsNullOrEmpty(wa))
            {
                var openMsg = Site.T("Hello Bardees, I'd like to ask about the abaya collection.", "مرحباً برديس، أود الاستفسار عن مجموعة العبايات.");
                <a class="btn btn-gold btn-lg" href="https://wa.me/@wa?text=@Uri.EscapeDataString(openMsg)" target="_blank" rel="noopener">
                    @Site.T("Order on WhatsApp", "اطلبي عبر واتساب") <i class="bi bi-whatsapp"></i>
                </a>
            }
        </div>
    </div>
</section>
