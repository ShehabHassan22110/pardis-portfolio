@model ErrorViewModel
@{
    Layout = null;
    var code = ViewData["StatusCode"] as int? ?? 500;
    var isAr = Site.IsArabic;
    var title = code == 404 ? (isAr ? "الصفحة غير موجودة" : "Page not found") : (isAr ? "حدث خطأ ما" : "Something went wrong");
    var note = code == 404
        ? (isAr ? "الصفحة التي تبحث عنها غير موجودة أو تم نقلها." : "The page you're looking for doesn't exist or has moved.")
        : (isAr ? "واجهنا خطأً غير متوقع. حاول مرة أخرى." : "We hit an unexpected error. Please try again.");
}
<!DOCTYPE html>
<html lang="@Site.Lang" dir="@Site.Dir" data-theme="@Site.Theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@code · BARDEES REFAAT</title>
    <meta name="robots" content="noindex" />
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Outfit:wght@300;400;600&display=swap" rel="stylesheet" />
    <style>
        :root { --bg:#1a1511; --text:#f0e9dc; --muted:#9a8e7e; --gold:#e0b489; --gold2:#c98a5e; }
        html[data-theme="light"] { --bg:#f0e9dc; --text:#211a15; --muted:#6f6353; }
        * { box-sizing:border-box; margin:0; }
        body { background:var(--bg); color:var(--text); font-family:"Outfit",system-ui,sans-serif; font-weight:300; min-height:100vh; display:grid; place-items:center; text-align:center; padding:24px; }
        .code { font-family:"Fraunces",serif; font-size:clamp(5rem,18vw,11rem); line-height:.9; background:linear-gradient(135deg,var(--gold),var(--gold2)); -webkit-background-clip:text; background-clip:text; color:transparent; }
        h1 { font-family:"Fraunces",serif; font-weight:500; font-size:clamp(1.4rem,4vw,2.2rem); margin:8px 0 10px; }
        p { color:var(--muted); max-width:44ch; margin:0 auto 26px; line-height:1.7; }
        a { display:inline-flex; gap:8px; align-items:center; padding:.7rem 1.4rem; border-radius:10px; text-decoration:none; font-weight:600; background:linear-gradient(135deg,var(--gold),var(--gold2)); color:#1a1511; }
    </style>
</head>
<body>
    <div>
        <div class="code">@code</div>
        <h1>@title</h1>
        <p>@note</p>
        <a href="/">@(isAr ? "العودة للرئيسية" : "Back to home")</a>
    </div>
</body>
</html>
