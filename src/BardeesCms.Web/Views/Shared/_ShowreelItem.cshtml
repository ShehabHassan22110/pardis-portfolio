@model ShowreelItemVm
@{
    var v = Model.Video;
    var yt = v.Provider == VideoProvider.YouTube && !string.IsNullOrEmpty(v.ProviderVideoId);
    var poster = !string.IsNullOrEmpty(v.Thumbnail) ? ImageResolver.Src(v.Thumbnail)
        : yt ? $"/yt/thumb/{v.ProviderVideoId}" : "";
    var title = Site.Pick(v.Title, v.TitleAr);
    var kicker = v.VideoCategory is null ? Site.T("Film", "فيلم") : Site.Pick(v.VideoCategory.Name, v.VideoCategory.NameAr);
    var trigger = yt ? $"data-youtube=\"{v.ProviderVideoId}\"" : (!string.IsNullOrEmpty(v.VideoUrl) ? $"data-video=\"{v.VideoUrl}\"" : "");
    var onerr = "this.style.display='none'";
}
<article class="sr-item@(Model.Main ? " sr-item--main" : "")@(v.IsPortrait ? " sr-item--portrait" : "") reveal" @Html.Raw(trigger) @(v.IsPortrait ? "data-portrait=1" : "") role="button" tabindex="0" aria-label="Play @title">
    @if (v.IsPortrait && !string.IsNullOrEmpty(poster)) { <img class="sr-item__bg" src="@poster" alt="" aria-hidden="true" loading="lazy" decoding="async" onerror="@onerr" /> }
    @if (!string.IsNullOrEmpty(poster)) { <img class="sr-item__img" src="@poster" alt="@title" loading="lazy" decoding="async" onerror="@onerr" /> }
    <span class="sr-item__scrim" aria-hidden="true"></span>
    <span class="sr-item__frame" aria-hidden="true"></span>
    <span class="sr-item__play"><i class="bi bi-play-fill"></i></span>
    <span class="sr-item__meta"><span class="k">@kicker</span><span class="t">@title</span></span>
</article>
