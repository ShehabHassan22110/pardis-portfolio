@model ContactViewModel
@inject IPublicContentService Content
@{
    Layout = "_Layout";
    var cs = Model.Settings;
    ViewData["Title"] = Site.Pick(cs?.Title, cs?.TitleAr) ?? Site.T("Contact", "تواصل");
    var wa = (cs?.WhatsApp ?? "").Trim();
    var email = (cs?.Email ?? "").Trim();
    var ig = (cs?.Instagram ?? "").Trim();
    var tiktok = (cs?.TikTok ?? "").Trim();
    bool Real(string? v) => !string.IsNullOrEmpty(v) && v != "#";
    var waIntro = Site.T("Hello Bardees, I'd like to discuss a collaboration.", "مرحباً برديس، أود التحدث بخصوص تعاون.");

    // Pull the full, canonical social set from Site Settings (same source the footer
    // uses) so every configured channel appears here — fall back to the contact-only
    // Instagram/TikTok/WhatsApp fields when a Site Settings value isn't set.
    var ss = (await Content.GetLayoutAsync()).Settings;
    var waNum = Real(wa) ? wa : (ss.WhatsApp ?? "").Trim();
    var phone = (cs?.Phone ?? "").Trim();
    var hasPhone = !string.IsNullOrEmpty(phone) && phone != "+966 5X XXX XXXX";
    // brand = the platform's real accent colour; ink = icon colour that reads on it.
    (string? url, string icon, string en, string ar, string brand, string ink)[] socials =
    {
        (Real(ss.InstagramUrl) ? ss.InstagramUrl : (Real(ig) ? ig : null), "instagram", "Instagram", "انستقرام", "#E1306C", "#fff"),
        (Real(ss.TikTokUrl) ? ss.TikTokUrl : (Real(tiktok) ? tiktok : null), "tiktok", "TikTok", "تيك توك", "#111111", "#fff"),
        (Real(ss.SnapchatUrl) ? ss.SnapchatUrl : null, "snapchat", "Snapchat", "سناب شات", "#F7B500", "#1a1511"),
        (Real(ss.FacebookUrl) ? ss.FacebookUrl : null, "facebook", "Facebook", "فيسبوك", "#1877F2", "#fff"),
        (Real(ss.LinkedInUrl) ? ss.LinkedInUrl : null, "linkedin", "LinkedIn", "لينكدإن", "#0A66C2", "#fff"),
        (Real(ss.YouTubeUrl) ? ss.YouTubeUrl : null, "youtube", "YouTube", "يوتيوب", "#FF0000", "#fff"),
        (Real(waNum) ? $"https://wa.me/{waNum}" : null, "whatsapp", "WhatsApp", "واتساب", "#25D366", "#fff"),
        (Real(email) ? $"mailto:{email}" : null, "envelope-fill", "Email", "البريد", "#C98A5E", "#1a1511"),
    };
}

<section class="section page-hero">
    <div class="container">
        <div class="title-c reveal" style="margin-inline:0;text-align:start">
            <span class="tc-eyebrow">@Site.T("Let's work together", "لنعمل معاً")</span>
            <h1 class="d-1 tc-h">@Html.Sanitized(Site.Pick(cs?.Title, cs?.TitleAr) ?? Site.T("Let's make something <em>unforgettable</em>.", "لنصنع شيئاً <em>لا يُنسى</em>."))</h1>
            @if (!string.IsNullOrEmpty(cs?.Description)) { <p class="tc-note" style="margin-inline:0;max-width:60ch">@Site.Pick(cs.Description, cs.DescriptionAr)</p> }
        </div>

        <div class="contact-grid reveal" data-d="1">
            <div>
                @if (Model.Sent)
                {
                    <div class="form-success">
                        <i class="bi bi-check-circle" style="font-size:2.4rem;color:var(--accent-2)"></i>
                        <h3 class="mt-3">@Site.T("Message sent", "تم الإرسال")</h3>
                        <p class="mb-0">@Site.T("Thank you — I'll be in touch shortly.", "شكراً لك — سأعود إليك قريباً.")</p>
                    </div>
                }
                else
                {
                    <form method="post" action="/contact" novalidate id="contactForm"
                          data-wa="@wa" data-email="@email" data-wa-intro="@waIntro">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="hp-field" aria-hidden="true"><label>Website</label><input asp-for="Form.Website" tabindex="-1" autocomplete="off" /></div>
                        <div class="form-2col">
                            <div class="form-field"><label asp-for="Form.Name">@Site.T("Name", "الاسم")</label><input asp-for="Form.Name" /><span asp-validation-for="Form.Name" class="text-danger"></span></div>
                            <div class="form-field"><label asp-for="Form.Email">@Site.T("Email", "البريد")</label><input asp-for="Form.Email" type="email" /><span asp-validation-for="Form.Email" class="text-danger"></span></div>
                        </div>
                        <div class="form-2col">
                            <div class="form-field"><label asp-for="Form.Phone">@Site.T("Phone", "الهاتف")</label><input asp-for="Form.Phone" /></div>
                            <div class="form-field"><label asp-for="Form.Company">@Site.T("Company", "الشركة")</label><input asp-for="Form.Company" /></div>
                        </div>
                        <div class="form-field">
                            <label asp-for="Form.Subject">@Site.T("Type of collaboration", "نوع التعاون")</label>
                            <select asp-for="Form.Subject">
                                <option value="">@Site.T("— Select —", "— اختر —")</option>
                                @foreach (var d in Model.Disciplines)
                                {
                                    var name = Site.Pick(d.Name, d.NameAr);
                                    <option value="@d.Name" selected="@(Model.Form.Subject == d.Name)">@name</option>
                                }
                                <option value="@Site.T("Other", "أخرى")" selected="@(Model.Form.Subject == Site.T("Other", "أخرى"))">@Site.T("Other", "أخرى")</option>
                            </select>
                        </div>
                        <div class="form-field"><label asp-for="Form.Message">@Site.T("Message", "الرسالة")</label><textarea asp-for="Form.Message" rows="5"></textarea><span asp-validation-for="Form.Message" class="text-danger"></span></div>
                        <button type="submit" class="btn btn-gold btn-lg">@Site.T("Send", "إرسال") <i class="bi bi-arrow-up-right"></i></button>
                        <p class="small mt-2" style="color:var(--muted)">@Site.T("Your message goes straight to Bardees' inbox — she'll reply shortly.", "تصل رسالتك مباشرةً إلى بريد برديس — وستردّ عليك قريباً.")</p>
                    </form>
                }
            </div>

            <aside class="contact-aside">
                @if (Real(waNum))
                {
                    <a class="btn btn-gold btn-lg w-100 mb-3 justify-content-center contact-wa" style="display:flex;align-items:center;gap:.5rem"
                       href="https://wa.me/@waNum?text=@Uri.EscapeDataString(waIntro)" target="_blank" rel="noopener">
                        <i class="bi bi-whatsapp"></i> @Site.T("Chat on WhatsApp", "تحدّث عبر واتساب")
                    </a>
                    <p class="small mb-4" style="color:var(--muted)">@Site.T("The fastest way to reach Bardees.", "أسرع طريقة للوصول إلى برديس.")</p>
                }

                <ul class="contact-facts">
                    @if (Real(email))
                    {
                        <li><span class="contact-facts__ic"><i class="bi bi-envelope"></i></span>
                            <span class="contact-facts__body"><span class="k">@Site.T("Email", "البريد")</span>
                            <a class="v" href="mailto:@email">@email</a></span></li>
                    }
                    @if (hasPhone)
                    {
                        <li><span class="contact-facts__ic"><i class="bi bi-telephone"></i></span>
                            <span class="contact-facts__body"><span class="k">@Site.T("Phone", "الهاتف")</span>
                            <a class="v" href="tel:@(phone.Replace(" ", ""))" dir="ltr">@phone</a></span></li>
                    }
                    @if (!string.IsNullOrEmpty(cs?.Location))
                    {
                        <li><span class="contact-facts__ic"><i class="bi bi-geo-alt"></i></span>
                            <span class="contact-facts__body"><span class="k">@Site.T("Location", "الموقع")</span>
                            <span class="v">@Site.Pick(cs.Location, cs.LocationAr)</span></span></li>
                    }
                </ul>

                @if (socials.Any(x => Real(x.url)))
                {
                    <p class="eyebrow contact-social-eyebrow">@Site.T("Find me on", "تابعني على")</p>
                    <div class="contact-socials">
                        @foreach (var soc in socials.Where(x => Real(x.url)))
                        {
                            <a class="social-ico" href="@soc.url" target="_blank" rel="noopener"
                               style="--brand:@soc.brand;--brand-ink:@soc.ink"
                               aria-label="@Site.Pick(soc.en, soc.ar)" title="@Site.Pick(soc.en, soc.ar)">
                                <i class="bi bi-@soc.icon"></i>
                            </a>
                        }
                    </div>
                }
            </aside>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
